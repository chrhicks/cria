{
  "name": "@cria/recording",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Recording of Cria's INDI traffic: the file format, the recorder, the reader and the verifier",
  "exports": {
    ".": {
      "@cria/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
