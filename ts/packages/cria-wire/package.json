{
  "name": "@cria/wire",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Wire protocol 5 between Cria and Vela: one Effect Schema per shape, imported by both",
  "exports": {
    ".": {
      "@cria/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json"
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts"
  ],
  "peerDependencies": {
    "@cria/primitives": "*",
    "effect": "4.0.3"
  },
  "devDependencies": {
    "@cria/primitives": "workspace:*",
    "effect": "4.0.3"
  }
}
