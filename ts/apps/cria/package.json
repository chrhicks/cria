{
  "name": "@cria/service",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Cria on Linux: connects INDI devices and taps the rig stream; serves /health and /connect",
  "bin": {
    "cria": "./dist/main.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "start": "node dist/main.js"
  },
  "dependencies": {
    "@cria/indi": "workspace:*",
    "@cria/stream": "workspace:*",
    "@cria/wire": "workspace:*",
    "effect": "4.0.3"
  },
  "devDependencies": {
    "@cria/fake-indi": "workspace:*"
  }
}
