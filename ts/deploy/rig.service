[Unit]
Description=Rig program: keeps the devices as the rig file says and records the INDI wire, the journal and PHD2 to the dev stream; exits when indiserver is lost
After=indiserver.service
Wants=indiserver.service
PartOf=indiserver.service
StartLimitIntervalSec=0

[Service]
ExecStart=/usr/bin/node %h/dev/personal/cria-ts/ts/src/bin/rig.ts %h/.config/cria/rig.json
Restart=always
RestartSec=1
RestartSteps=5
RestartMaxDelaySec=60
RestartPreventExitStatus=2

[Install]
WantedBy=default.target
