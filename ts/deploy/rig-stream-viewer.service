[Unit]
Description=Rig stream viewer: the dev stream's web page; keeps retrying until the broker answers
StartLimitIntervalSec=0

[Service]
ExecStart=/usr/bin/node %h/dev/personal/cria-run/ts/src/bin/viewer.ts %h/.config/rig-stream/viewer.json
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
