# One indiserver for every rig driver, started at login (linger) and restarted if
# it dies. User unit: install to ~/.config/systemd/user/ (README.md).
#
# -r 0: indiserver never restarts a crashed driver by itself. The rig program
#       does that, and only when nothing is running on the device.
# -f:   the FIFO the rig program writes `stop <driver>` / `start <driver>` to,
#       so one driver can be restarted without touching the others. %t is
#       $XDG_RUNTIME_DIR; the rig program's default FIFO path is the same.
#
# Restart the rig software as one: `systemctl --user restart indiserver`. The rig
# program is PartOf this unit, so systemd stops it first, restarts indiserver and
# every driver, waits in ExecStartPost until the drivers are up (indi-ready.sh),
# and only then starts it again.
[Unit]
StartLimitIntervalSec=0
Description=INDI server for the rig drivers

[Service]
# indiserver opens the FIFO but does not create it, and exits 1 if it is missing.
ExecStartPre=-/usr/bin/mkfifo %t/indi.fifo
ExecStart=/usr/bin/indiserver -v -r 0 -p 7624 -f %t/indi.fifo indi_asi_ccd indi_asi_focuser indi_lx200am5 indi_pegasus_ppba
# Same driver list as ExecStart. Adjust the path to where the repository is checked out.
ExecStartPost=%h/dev/personal/cria-ts/ts/deploy/indi-ready.sh indi_asi_ccd indi_asi_focuser indi_lx200am5 indi_pegasus_ppba
TimeoutStartSec=90
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
