[Unit]
Description=Cria (INDI connection and rig stream tap)
# Retry forever: at boot the tailnet address Cria listens on (EADDRNOTAVAIL) does not exist until
# tailscale is up, and the default start limit would give up after 5 tries in 10 s.
StartLimitIntervalSec=0
After=indiserver.service
Wants=indiserver.service
# Stopped and restarted with indiserver, after it is healthy (see indiserver.service).
PartOf=indiserver.service

[Service]
# Adjust to where Cria is checked out, and to the config in use.
ExecStart=/usr/bin/node %h/dev/personal/cria-ts/ts/src/bin/cria.ts %h/.config/cria/rig.json
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
