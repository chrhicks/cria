# User unit: install to ~/.config/systemd/user/ (README.md). Disable with
# `systemctl --user disable --now rig-supervisor`. It reads
# ~/.config/cria/supervisor.json.
[Unit]
StartLimitIntervalSec=0
Description=Rig supervisor (restart a driver for a device that appeared, connect a device that is disconnected)
After=cria.service
# Stopped and restarted with indiserver, so it never restarts a driver mid-restart.
PartOf=indiserver.service

[Service]
ExecStart=/usr/bin/node %h/dev/personal/cria-ts/ts/src/bin/rig.ts
Restart=always
RestartSec=5
# Exit 2 is a bad config file: restarting cannot fix it.
RestartPreventExitStatus=2

[Install]
WantedBy=default.target
